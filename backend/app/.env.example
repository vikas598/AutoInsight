# AutoInsight — environment variables
# Copy to .env in your backend/ folder and fill in real values.
# NEVER commit .env to git.

# ============================================================
# Database (two restricted roles — see db_users.sql)
# ============================================================
DATABASE_URL_READ=postgresql://autoinsight_reader:your_reader_password@localhost:5432/autoinsight
DATABASE_URL_WRITE=postgresql://autoinsight_writer:your_writer_password@localhost:5432/autoinsight

# Convenience alias — some tooling expects a single DATABASE_URL
DATABASE_URL=postgresql://autoinsight_reader:your_reader_password@localhost:5432/autoinsight

# ============================================================
# Encryption key for stored credentials (Fernet / AES-256)
# ============================================================
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=paste-generated-key-here

# ============================================================
# LLM Provider — using Groq's free tier by default
# ============================================================
# Get your free Groq API key at: https://console.groq.com/keys
# Groq's free tier gives you 30 req/min on Llama 3.3 70B — enough for dev.
# No credit card required.

LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_here

# Models — Groq's current catalog (Oct 2026)
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant

# ---- Alternative providers (uncomment to switch) ----
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_FAST_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=together
# LLM_API_KEY=...
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Advanced: override base URL (only needed for custom endpoints / Ollama / vLLM)
# LLM_BASE_URL=http://localhost:11434/v1

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
